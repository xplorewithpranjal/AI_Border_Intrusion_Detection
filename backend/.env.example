# Application Configuration
APP_NAME="Static Camera Geospatial Localization and Motion Analysis System"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"

# Server
HOST="127.0.0.1"
PORT=8000

# Database
# Default SQLite for portable prototype; can be switched to PostgreSQL/MySQL
DATABASE_URL="sqlite:///./geoloc_system.db"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
